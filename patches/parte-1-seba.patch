@@ -0,0 +1,62 @@
+{% extends "calificaciones/base_cal.html" %}
+{% comment %}
+   "MIS NOTAS" DEL ALUMNO
+   - El alumno ve solo sus notas: materia, valoración, calificación y estado.
+   - TED en rojo; si la asistencia no llega al 80 %, el estado dice
+     "No acredita por asistencia".
+   - El acceso al boletín aparece recién cuando secretaría lo publica.
+{% endcomment %}
+
+{% block title %}Mis notas — SGE{% endblock %}
+
+{% block hero %}
+<section class="hero">
+    <div class="hero-textos">
+        <h1>Mis notas</h1>
+        <p class="hero-sub">{{ nombre }} · {{ curso }} · Ciclo lectivo {{ ciclo_lectivo }}</p>
+    </div>
+    <div class="segmento" role="group" aria-label="Cuatrimestre">
+        <a class="{% if cuat == 1 %}activo{% endif %}" href="?cuat=1">1° cuatrimestre</a>
+        <a class="{% if cuat == 2 %}activo{% endif %}" href="?cuat=2">2° cuatrimestre</a>
+    </div>
+</section>
+{% endblock %}
+
+{% block content %}
+<div class="dos-columnas">
+    <div class="card tabla-wrap">
+        <table class="tabla">
+            <tr><th>Materia</th><th>Val. preliminar</th><th>Calificación</th><th>Estado</th></tr>
+            {% for m in materias %}
+            <tr>
+                <td class="fuerte">{{ m.materia }}</td>
+                <td>{% if m.valoracion %}<span{% if m.valoracion == 'TED' %} class="ted"{% endif %}>{{ m.valoracion }}</span>{% else %}—{% endif %}</td>
+                <td class="fuerte">{{ m.calificacion|default:"—" }}</td>
+                <td>{% if m.estado %}<span class="chip {% if m.aprobada %}ok{% else %}wa{% endif %}">{{ m.estado }}</span>{% else %}—{% endif %}</td>
+            </tr>
+            {% empty %}
+            <tr><td class="vacia" colspan="4">Todavía no hay materias en tu curso.</td></tr>
+            {% endfor %}
+        </table>
+    </div>
+
+    <div class="columna">
+        <div class="card tarjeta borde-oscuro">
+            <h3 class="tarjeta-titulo">Mi boletín</h3>
+            <p class="ayuda">Promedio del {{ cuat }}° cuatrimestre</p>
+            <p class="numero grande">{{ promedio_general|default:"—" }}</p>
+            {% if boletin_publicado %}
+            <a class="btn p" href="{% url 'alumno_ver_boletin' %}">Ver boletín completo</a>
+            <a class="btn" href="{% url 'alumno_ver_boletin' %}?imprimir=1">Imprimir / guardar como PDF</a>
+            {% else %}
+            <p class="ayuda">El boletín se habilita a fin de año. Mientras tanto, estas son tus notas.</p>
+            {% endif %}
+        </div>
+        <div class="card tarjeta borde-verde">
+            <h3 class="tarjeta-titulo">Inasistencias</h3>
+            <p class="numero grande">{{ inasistencias|default:"—" }}</p>
+            <p class="nota">{{ cuat }}° cuatrimestre</p>
+        </div>
+    </div>
+</div>
+{% endblock %}
diff --git a/templates/calificaciones/menu_docente.html b/templates/calificaciones/menu_docente.html
new file mode 100644
index 0000000..e690d88
--- /dev/null
+++ b/templates/calificaciones/menu_docente.html
@@ -0,0 +1,65 @@
+{% extends "calificaciones/base_cal.html" %}
+{% comment %}
+   INICIO DEL DOCENTE
+   - Resumen: materias a cargo, materias con notas sin cargar y materias
+     con el cuatrimestre cerrado.
+   - Cada materia muestra si su cuatrimestre está abierto, completo o
+     cerrado (con la fecha de cierre de ESA materia).
+   - Una tarjeta por materia (y por curso) con sus accesos.
+{% endcomment %}
+
+{% block title %}Calificaciones — SGE{% endblock %}
+
+{% block hero %}
+<section class="hero">
+    <div class="hero-textos">
+        <h1>Calificaciones</h1>
+        <p class="hero-sub">Ciclo lectivo {{ ciclo_lectivo }} · Tus materias y planillas</p>
+    </div>
+    <div class="segmento" role="group" aria-label="Cuatrimestre">
+        <a class="{% if cuat == 1 %}activo{% endif %}" href="?cuat=1">1° cuatrimestre</a>
+        <a class="{% if cuat == 2 %}activo{% endif %}" href="?cuat=2">2° cuatrimestre</a>
+    </div>
+</section>
+{% endblock %}
+
+{% block content %}
+<div class="stats">
+    <div class="card stat"><span class="numero">{{ total_materias }}</span><span class="ayuda">Materias a cargo</span></div>
+    <div class="card stat ambar"><span class="numero">{{ sin_cargar }}</span><span class="ayuda">Materias con notas sin cargar</span></div>
+    <div class="card stat verde"><span class="numero">{{ cerradas }} de {{ total_materias }}</span><span class="ayuda">Materias con el {{ cuat }}° cuatrimestre cerrado</span></div>
+</div>
+
+<h2 class="seccion-titulo">Mis materias</h2>
+
+{% if materias %}
+<div class="grid-tarjetas">
+    {% for m in materias %}
+    <div class="card tarjeta {% if m.fecha_cierre or m.completo %}borde-verde{% else %}borde-azul{% endif %}">
+        <div class="tarjeta-cabecera">
+            <h3 class="tarjeta-titulo">{{ m.nombre }}</h3>
+            {% if m.fecha_cierre %}<span class="chip ne">{{ cuat }}° cuat. cerrado el {{ m.fecha_cierre }}</span>
+            {% elif m.completo %}<span class="chip ok">{{ cuat }}° cuat. completo</span>
+            {% else %}<span class="chip wa">{{ cuat }}° cuat. abierto</span>{% endif %}
+        </div>
+        <p class="ayuda">{{ m.curso }} · {{ m.estudiantes }} estudiantes</p>
+        <p class="nota">{% if m.pct is None %}Creá categorías para poder cargar notas{% else %}Notas cargadas: {{ m.pct }}%{% endif %}</p>
+        <div class="progreso"><div style="width: {{ m.pct|default:0 }}%"></div></div>
+        <div class="grupo-botones">
+            <a class="btn p" href="{% url 'profesor_cargar_notas' cuat=cuat materia_id=m.id %}">Cargar notas</a>
+            <a class="btn" href="{% url 'profesor_planilla' cuat=cuat materia_id=m.id %}">Ver planilla</a>
+        </div>
+        <div class="tarjeta-pie">
+            <a class="link-sec" href="{% url 'profesor_categorias' cuat=cuat materia_id=m.id %}">Categorías</a>
+            {% if not m.fecha_cierre %}<a class="link-sec" href="{% url 'profesor_cargar_excel' cuat=cuat materia_id=m.id %}">Importar Excel</a>{% endif %}
+        </div>
+    </div>
+    {% endfor %}
+</div>
+{% else %}
+<div class="card tarjeta borde-azul">
+    <h3 class="tarjeta-titulo">Todavía no tenés materias asignadas</h3>
+    <p class="ayuda">Cuando el módulo Docentes te asigne materias, van a aparecer acá con su planilla.</p>
+</div>
+{% endif %}
+{% endblock %}
