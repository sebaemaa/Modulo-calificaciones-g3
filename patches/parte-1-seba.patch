-{% block extra_js %}
-<script>
-(function () {
-    var tabla = document.getElementById('tabla-planilla');
-    if (!tabla) return;
-
-    var indicador = document.getElementById('indicador');
-    function mostrar(msg, color) {
-        if (!indicador) return;
-        indicador.textContent = msg;
-        indicador.style.color = color || '#43a047';
-    }
-
-    // Obtener CSRF token desde la cookie
-    function getCookie(name) {
-        var value = '; ' + document.cookie;
-        var parts = value.split('; ' + name + '=');
-        if (parts.length === 2) return parts.pop().split(';').shift();
-    }
-
-    // Recalcular promedios locales (visual) sin esperar al servidor
-    function recalcularFila(fila, promBd, estadoBd) {
-        var promCelda = fila.querySelector('[data-prom]');
-        var estCelda = fila.querySelector('[data-estado]');
-        if (promBd !== undefined && promBd !== null && promBd !== '-') {
-            promCelda.textContent = promBd;
-            promCelda.style.color = estadoBd === 'Aprobado' ? '#2e7d32' : '#c62828';
-            estCelda.textContent = estadoBd;
-            estCelda.className = 'estado-cell ' + (estadoBd === 'Aprobado' ? 'estado-aprobado' : 'estado-desaprobado');
-        } else {
-            promCelda.textContent = '—';
-            promCelda.style.color = '#1a3a6b';
-            estCelda.textContent = '—';
-            estCelda.className = 'estado-cell';
-        }
-    }
-
-    // Navegación estilo hoja de cálculo
-    function moveFocus(input, dir) {
-        var inputs = Array.from(tabla.querySelectorAll('.celda-nota input'));
-        var idx = inputs.indexOf(input);
-        if (idx < 0) return;
-        var filas = Array.from(tabla.querySelectorAll('tbody tr[data-alumno]'));
-        var camposPorFila = filas[0].querySelectorAll('.celda-nota input').length;
-        var filaIdx = Math.floor(idx / camposPorFila);
-        var colIdx = idx % camposPorFila;
-
-        if (dir === 'next' || dir === 'prev') {
-            var ni = dir === 'next' ? idx + 1 : idx - 1;
-            if (ni >= 0 && ni < inputs.length) inputs[ni].focus();
-        } else if (dir === 'down' && filaIdx + 1 < filas.length) {
-            inputs[(filaIdx + 1) * camposPorFila + colIdx].focus();
-        } else if (dir === 'up' && filaIdx - 1 >= 0) {
-            inputs[(filaIdx - 1) * camposPorFila + colIdx].focus();
-        }
-    }
-
-    tabla.addEventListener('keydown', function (e) {
-        var t = e.target;
-        if (t.tagName !== 'INPUT') return;
-        if (e.key === 'Tab') { e.preventDefault(); moveFocus(t, e.shiftKey ? 'prev' : 'next'); }
-        else if (e.key === 'Enter') { e.preventDefault(); moveFocus(t, 'next'); }
-        else if (e.key === 'ArrowDown') { e.preventDefault(); moveFocus(t, 'down'); }
-        else if (e.key === 'ArrowUp') { e.preventDefault(); moveFocus(t, 'up'); }
-        else if (e.key === 'ArrowRight') { e.preventDefault(); moveFocus(t, 'next'); }
-        else if (e.key === 'ArrowLeft') { e.preventDefault(); moveFocus(t, 'prev'); }
-    });
-
-    tabla.addEventListener('focusin', function (e) {
-        var t = e.target;
-        if (t.tagName === 'INPUT') setTimeout(function () { t.select(); }, 0);
-    });
-
-    // Guardar al salir de la celda (blur) — guardado automático
-    tabla.addEventListener('focusout', function (e) {
-        var input = e.target;
-        if (input.tagName !== 'INPUT' || !input.dataset.url) return;
-
-        var valor = input.value.trim();
-        var fila = input.closest('tr');
-
-        mostrar('Guardando...');
-
-        var formData = new FormData();
-        formData.append('alumno_id', input.dataset.alumno);
-        formData.append('cat_id', input.dataset.cat);
-        formData.append('valor', valor);
-
-        fetch(input.dataset.url, {
-            method: 'POST',
-            body: formData,
-            headers: { 'X-CSRFToken': getCookie('csrftoken') }
-        })
-        .then(function (res) { return res.json().then(function (data) { return { res: res, data: data }; }); })
-        .then(function (obj) {
-            if (!obj.res.ok || !obj.data.ok) {
-                var err = (obj.data && obj.data.error) || 'Error al guardar';
-                mostrar('⚠ ' + err, '#c62828');
-                return;
-            }
-            input.classList.add('celda-guardada');
-            setTimeout(function () { input.classList.remove('celda-guardada'); }, 1200);
-            recalcularFila(fila, obj.data.promedio, obj.data.estado);
-            mostrar('✓ Guardado');
-            setTimeout(function () { mostrar(''); }, 1500);
-        })
-        .catch(function () {
-            mostrar('⚠ Error de conexión', '#c62828');
-        });
-    });
-})();
-</script>
-{% endblock %}
