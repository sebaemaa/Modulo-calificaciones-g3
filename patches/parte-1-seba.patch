diff --git a/templates/calificaciones/base_cal.html b/templates/calificaciones/base_cal.html
new file mode 100644
index 0000000..e65b767
--- /dev/null
+++ b/templates/calificaciones/base_cal.html
@@ -0,0 +1,100 @@
+{% load static %}<!doctype html>
+{% comment %}
+   PLANTILLA BASE DEL MÓDULO CALIFICACIONES
+   Todas las pantallas del módulo la extienden. Tiene la misma barra y el
+   mismo footer que el resto del sistema, pero carga solo el CSS del módulo
+   (calificaciones.css), así no choca con los estilos de otros grupos.
+
+   Bloques que completa cada pantalla:
+   - title:      título de la pestaña.
+   - hero:       encabezado celeste con título, miga de pan y botones.
+   - main_class: "ancho" para usar todo el ancho (planilla).
+   - content:    contenido de la pantalla.
+   - extra_css / extra_js: estilos o scripts propios de la pantalla.
+{% endcomment %}
+<html lang="es">
+<head>
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width, initial-scale=1.0">
+<title>{% block title %}Calificaciones — SGE{% endblock %}</title>
+<link rel="preconnect" href="https://fonts.googleapis.com">
+<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
+<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
+<link rel="stylesheet" href="{% static 'css/calificaciones.css' %}?v=20261111-2">
+{% block extra_css %}{% endblock %}
+</head>
+<body>
+
+<nav>
+    <button class="hamburger" type="button" aria-label="Menú"><span></span><span></span><span></span></button>
+    <a href="/" class="logo"><img src="https://tecnica3hurlingham.com/logot3.png" alt="Logo"> SGE</a>
+    <ul>
+        <li><a href="/">Inicio</a></li>
+        <li><a href="/alumnos/">Alumnos</a></li>
+        <li><a href="/asistencia/">Asistencia</a></li>
+        <li><a href="/calificaciones/">Calificaciones</a></li>
+        <li><a href="/docentes/">Docentes</a></li>
+        <li><a href="/comunicados/">Comunicados</a></li>
+        {% if user.is_authenticated %}
+        {% comment %} El link al perfil aparece solo si el proyecto tiene la ruta 'perfil'. {% endcomment %}
+        {% url 'perfil' as url_perfil %}
+        <li>
+            {% if url_perfil %}<a href="{{ url_perfil }}" class="nav-chip" title="Mi perfil">{% else %}<span class="nav-chip">{% endif %}
+                {{ user.username|upper }}{% if perfil %} · {{ perfil.get_rol_display }}{% endif %}
+            {% if url_perfil %}</a>{% else %}</span>{% endif %}
+        </li>
+        <li>
+            <form method="post" action="{% url 'logout' %}" class="nav-logout-form">
+                {% csrf_token %}
+                {% comment %} Al salir vuelve al inicio de sesión (sin esto Django muestra la página del admin). {% endcomment %}
+                <input type="hidden" name="next" value="{% url 'login' %}">
+
+                <button type="submit" class="nav-logout" title="Cerrar sesión" aria-label="Cerrar sesión">
+                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
+                        <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
+                        <polyline points="16 17 21 12 16 7"></polyline>
+                        <line x1="21" y1="12" x2="9" y2="12"></line>
+                    </svg>
+                </button>
+            </form>
+        </li>
+        {% endif %}
+    </ul>
+</nav>
+
+{% if messages %}
+<div class="messages-container">
+    {% for message in messages %}
+    <div class="alert alert-{{ message.tags }}">
+        <span>{{ message }}</span>
+        <button class="alert-close" type="button" aria-label="Cerrar" onclick="this.parentElement.remove()">&times;</button>
+    </div>
+    {% endfor %}
+</div>
+{% endif %}
+
+{% block hero %}{% endblock %}
+
+<main class="cal-main {% block main_class %}{% endblock %}">
+{% block content %}{% endblock %}
+</main>
+
+<footer>
+    <p class="footer-titulo">E.E.S.T N°3 Víctor Mercante</p>
+    <p class="footer-sub">Sistema de Gestión Escolar — 2026</p>
+    <p class="footer-copy">&copy; 2026 E.E.S.T N°3 Víctor Mercante &mdash; Hurlingham</p>
+</footer>
+
+<script>
+// Menú hamburguesa para pantallas chicas (igual que en base.html).
+document.addEventListener('DOMContentLoaded', function () {
+    var hamburger = document.querySelector('.hamburger');
+    var nav = document.querySelector('nav');
+    if (hamburger && nav) {
+        hamburger.addEventListener('click', function () { nav.classList.toggle('nav-open'); });
+    }
+});
+</script>
+{% block extra_js %}{% endblock %}
+</body>
+</html>
