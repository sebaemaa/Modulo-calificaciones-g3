+    var filas = document.querySelectorAll('#tabla-planillas tr:not(:first-child):not(.sin-resultados)');
+    var vacio = document.querySelector('#tabla-planillas .sin-resultados');
+    buscador.addEventListener('input', function () {
+        var texto = buscador.value.trim().toLowerCase();
